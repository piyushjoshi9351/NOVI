# Docker compose environment template - copy to .env at project root
# This key is injected into both the LettA container and the backend; it must
# match the one in backend/.env (see MEMORY_SYSTEM.md Â§7).
GEMINI_API_KEY=your_gemini_api_key

# Internal shared secret for Letta tool callbacks (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
INTERNAL_SHARED_SECRET=

# Google OAuth server-side flow (backend/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
