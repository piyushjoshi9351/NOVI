# Docker compose environment template - copy to .env at project root
# This key is injected into the Letta container and must match backend/.env
GEMINI_API_KEY=your_gemini_api_key

# Password used to secure the Letta server (generated automatically if unset)
LETTA_SERVER_PASSWORD=

# Google OAuth server-side flow (backend/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000