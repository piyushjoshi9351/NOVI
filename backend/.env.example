# Backend environment template - copy to backend/.env and fill in real values
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=novi_db
LETTA_BASE_URL=http://localhost:8283
LETTA_API_KEY=your_letta_api_key
GEMINI_API_KEY=your_gemini_api_key
SECRET_KEY=your_secret_key

# Google OAuth (required for "Continue with Google").
# backend/.env is sourced into the Docker backend via env_file in docker-compose.yml,
# so these three must be set here for OAuth to work in the container too.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Must match the exact redirect URI registered in Google Cloud Console:
# e.g. http://localhost:8000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Origin the browser returns to after Google sign-in (the Next.js app, usually)
FRONTEND_URL=http://localhost:3000
# Google model handle the onboarding LettA agents use (overrides the default)
LETTA_AGENT_MODEL=google_ai/gemini-3.6-flash

# Voice onboarding (ElevenLabs) - optional; /voice/speak + /voice/transcribe return 502 without them
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Letta Onboarding
INTERNAL_SHARED_SECRET=your_internal_shared_secret
INTERNAL_CALLBACK_BASE_URL=http://localhost:8000

# Onboarding engine: "new" (conversational, default) or "legacy" (old flow at /api/v1/onboarding/legacy)
ONBOARDING_ENGINE=legacy
